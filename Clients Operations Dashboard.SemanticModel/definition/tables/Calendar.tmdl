	column WeekType
		lineageTag: b02971d4-acfb-4239-981f-e04159a37ea9
		summarizeBy: none
		isNameInferred
		sourceColumn: [WeekType]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date],"mmm"),
				    "Monthnum", MONTH([Date]),
				    "Weekday", FORMAT([Date],"ddd"),
				    "Weeknum", WEEKDAY([Date]),
				    "Qtr", "Q-" & FORMAT([Date],"Q"),
				    "WeekType", IF(WEEKDAY([Date])=1|| WEEKDAY([Date]) = 7, "weekend", "weekday")
				)

	annotation PBI_Id = 66c20da069e84cdcaeedffa4e1321e83

