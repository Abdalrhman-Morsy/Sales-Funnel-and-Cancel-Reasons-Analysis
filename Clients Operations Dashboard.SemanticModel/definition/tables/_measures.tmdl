	measure 'Core Stages Percentages' =
			
			VAR _core_stages = {"Cancellation", "Meeting", "Reservation", "Done deal"}
			VAR _count =
			    CALCULATE(
			        COUNT(fact_interactions[id]),
			        KEEPFILTERS(dim_stage[stage] IN _core_stages)
			    )
			VAR _total =
			    CALCULATE(
			        COUNT(fact_interactions[id]),
			        ALL(dim_stage)
			    )
			RETURN
			IF(
			    ISBLANK(_count),
			    BLANK(),
			    ROUND(DIVIDE(_count, _total) * 100, 1)
			)
		formatString: 0.0
		lineageTag: 9b2a9477-3bac-4079-a193-c63c1d1a9cd6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

