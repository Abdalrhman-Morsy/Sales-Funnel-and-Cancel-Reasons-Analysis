	measure 'max stage per client' =
			VAR _current_stage_id = MAX(dim_stage[id])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(fact_interactions[client_id]),
			    FILTER(
			        VALUES(dim_clients[id]),
			        CALCULATE(
			            MAX(fact_interactions[stage_id]),
			            REMOVEFILTERS(dim_stage)
			        ) = _current_stage_id
			    )
			)
		formatString: 0
		lineageTag: da19a29a-2137-45b4-b5ed-de4122b0ac6f

	measure 'Cancellations Sales Reps' = ```
			
			VAR cancellation_id = LOOKUPVALUE(dim_stage[id],dim_stage[stage], "Cancellation")
			RETURN 
			CALCULATE(
			    [Total Clients],
			    dim_clients[last_stage_id] = cancellation_id,
			    USERELATIONSHIP(dim_clients[max_stage_id], dim_stage[id])
			)
			```
		formatString: 0
