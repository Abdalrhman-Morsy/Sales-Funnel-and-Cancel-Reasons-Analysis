	measure 'In Funnel Clients' = [Total Clients] - [Cancellations Sales Reps] // last stage is not cancellation "they are still in the funnel"
		formatString: 0
		lineageTag: 229621cd-d753-48ec-958b-1caec69ef8a0

	measure 'Top 1 Cancel Reason' =
			VAR RepClients = CALCULATETABLE(VALUES(fact_interactions[client_id]))
			VAR t =
			    FILTER(
			        ADDCOLUMNS(
			            FILTER(ALL(dim_cancel_reason[id], dim_cancel_reason[cancel_reason]), NOT ISBLANK(dim_cancel_reason[id])),
			            "cnt", CALCULATE(DISTINCTCOUNT(dim_clients[id]), dim_clients[id] IN RepClients, NOT ISBLANK(dim_clients[cancel_reason_id]))
			        ),
			        [cnt] > 0
			    )
			VAR top1 = TOPN(1, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			RETURN MINX(top1, dim_cancel_reason[cancel_reason])
		lineageTag: 05e75095-0f2a-43c6-9853-c55c10e200d9

	measure 'Top 1 Cancel Reason Count' =
			VAR RepClients = CALCULATETABLE(VALUES(fact_interactions[client_id]))
			VAR t =
			    FILTER(
			        ADDCOLUMNS(
			            FILTER(ALL(dim_cancel_reason[id], dim_cancel_reason[cancel_reason]), NOT ISBLANK(dim_cancel_reason[id])),
			            "cnt", CALCULATE(DISTINCTCOUNT(dim_clients[id]), dim_clients[id] IN RepClients, NOT ISBLANK(dim_clients[cancel_reason_id]))
			        ),
			        [cnt] > 0
			    )
			VAR top1 = TOPN(1, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			RETURN MINX(top1, [cnt])
		formatString: 0
		lineageTag: 6a72b244-ddc9-401b-8200-002390201d20

	measure 'Top 2 Cancel Reason' =
			VAR RepClients = CALCULATETABLE(VALUES(fact_interactions[client_id]))
			VAR t =
			    FILTER(
			        ADDCOLUMNS(
			            FILTER(ALL(dim_cancel_reason[id], dim_cancel_reason[cancel_reason]), NOT ISBLANK(dim_cancel_reason[id])),
			            "cnt", CALCULATE(DISTINCTCOUNT(dim_clients[id]), dim_clients[id] IN RepClients, NOT ISBLANK(dim_clients[cancel_reason_id]))
			        ),
			        [cnt] > 0
			    )
			VAR top1 = TOPN(1, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			VAR top2 = TOPN(2, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			VAR rank2 = EXCEPT(top2, top1)
			RETURN MINX(rank2, dim_cancel_reason[cancel_reason])
		lineageTag: a631f581-c411-432f-8b4c-0fae82b62610

	measure 'Top 2 Cancel Reason Count' =
			VAR RepClients = CALCULATETABLE(VALUES(fact_interactions[client_id]))
			VAR t =
			    FILTER(
			        ADDCOLUMNS(
			            FILTER(ALL(dim_cancel_reason[id], dim_cancel_reason[cancel_reason]), NOT ISBLANK(dim_cancel_reason[id])),
			            "cnt", CALCULATE(DISTINCTCOUNT(dim_clients[id]), dim_clients[id] IN RepClients, NOT ISBLANK(dim_clients[cancel_reason_id]))
			        ),
			        [cnt] > 0
			    )
			VAR top1 = TOPN(1, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			VAR top2 = TOPN(2, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			VAR rank2 = EXCEPT(top2, top1)
			RETURN MINX(rank2, [cnt])
		formatString: 0
		lineageTag: 46efdf3a-c339-4faf-be12-4242e57a9ba7

	measure 'Top 3 Cancel Reason' =
			VAR RepClients = CALCULATETABLE(VALUES(fact_interactions[client_id]))
			VAR t =
			    FILTER(
			        ADDCOLUMNS(
			            FILTER(ALL(dim_cancel_reason[id], dim_cancel_reason[cancel_reason]), NOT ISBLANK(dim_cancel_reason[id])),
			            "cnt", CALCULATE(DISTINCTCOUNT(dim_clients[id]), dim_clients[id] IN RepClients, NOT ISBLANK(dim_clients[cancel_reason_id]))
			        ),
			        [cnt] > 0
			    )
			VAR top2 = TOPN(2, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			VAR top3 = TOPN(3, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			VAR rank3 = EXCEPT(top3, top2)
			RETURN MINX(rank3, dim_cancel_reason[cancel_reason])
		lineageTag: ab4fc184-e861-4ab0-a91e-96b32e802b78

	measure 'Top 3 Cancel Reason Count' =
			VAR RepClients = CALCULATETABLE(VALUES(fact_interactions[client_id]))
			VAR t =
			    FILTER(
			        ADDCOLUMNS(
			            FILTER(ALL(dim_cancel_reason[id], dim_cancel_reason[cancel_reason]), NOT ISBLANK(dim_cancel_reason[id])),
			            "cnt", CALCULATE(DISTINCTCOUNT(dim_clients[id]), dim_clients[id] IN RepClients, NOT ISBLANK(dim_clients[cancel_reason_id]))
			        ),
			        [cnt] > 0
			    )
			VAR top2 = TOPN(2, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			VAR top3 = TOPN(3, t, [cnt], DESC, dim_cancel_reason[id], ASC)
			VAR rank3 = EXCEPT(top3, top2)
