table _measures
	lineageTag: f23103c1-bd98-4295-ab13-f7f825397507

	measure 'Total Clients' =
			CALCULATE(
			    DISTINCTCOUNT(fact_interactions[client_id]),
			    dim_clients[answer_count] > 0
			    )
		formatString: 0
		lineageTag: dd5a42eb-89f9-4e8d-a428-2fc62fa14311

	measure 'Stage ID' = SELECTEDVALUE(dim_stage[id])
		formatString: 0
		lineageTag: f957d159-52b2-4f1c-b3c0-40e85d581474

	measure Cancellations = ```
			
			VAR cancellation_id = LOOKUPVALUE(
			    dim_stage[id], 
			    dim_stage[stage], 
			    "Cancellation"
			)
			
			VAR clients_max_stage = CALCULATE(
			    [Total Clients],
			    dim_clients[last_stage_id] = cancellation_id,
			    USERELATIONSHIP(dim_clients[max_stage_id], dim_stage[id])
			    )
			RETURN clients_max_stage
			```
		formatString: 0
		lineageTag: 2e658006-788a-4fae-bf9f-e3a9377ed6c7

